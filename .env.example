# Resend (https://resend.com) — used by src/app/api/inquiry/route.ts to send
# the consultation form's submissions by email instead of opening a mailto:
# link. Copy this file to .env.local and fill in real values; .env.local is
# gitignored and must never be committed.

# Required. Create at https://resend.com/api-keys — needs "Sending access".
RESEND_API_KEY=

# Optional. The verified sender address inquiries are sent FROM. Must be on
# a domain you've verified in Resend (https://resend.com/domains) — until
# rbis.global (or a subdomain) is verified there, leave this unset to use
# Resend's shared onboarding@resend.dev sender, which works immediately
# with no setup but is only meant for testing, not production.
# RESEND_FROM_EMAIL="RBI Solutions <inquiry@rbis.global>"
