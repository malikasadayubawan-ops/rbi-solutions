# Resend (https://resend.com) — used by src/app/api/inquiry/route.ts to send
# the consultation form's submissions by email instead of opening a mailto:
# link. Copy this file to .env.local and fill in real values; .env.local is
# gitignored and must never be committed.

# Required. Create at https://resend.com/api-keys — needs "Sending access".
RESEND_API_KEY=

# Optional. The verified sender address inquiries are sent FROM. Must be on
# a domain you've verified in Resend (https://resend.com/domains) — until
# rbis.global (or a subdomain) is verified there, leave this unset to use
# Resend's shared onboarding@resend.dev sender, which works immediately
# with no setup but is only meant for testing, not production.
# RESEND_FROM_EMAIL="RBI Solutions <inquiry@rbis.global>"

# --- Not yet implemented — Cloudflare Turnstile (optional, future) --------
# The inquiry form currently relies on a server-validated honeypot field
# for spam protection (see src/app/api/inquiry/route.ts), not a CAPTCHA.
# If spam volume becomes a real problem, Cloudflare Turnstile can be added
# without a redesign: render Turnstile's widget in InquiryForm.tsx using
# NEXT_PUBLIC_TURNSTILE_SITE_KEY, submit its response token alongside the
# existing payload, and verify that token server-side in route.ts against
# Cloudflare's siteverify endpoint using TURNSTILE_SECRET_KEY before
# sending the email — rejecting the request if verification fails. Neither
# variable is read by any code today; both are unset here deliberately, and
# must never be filled in with real values in this file (which is
# committed) — only in a local, gitignored .env.local.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
